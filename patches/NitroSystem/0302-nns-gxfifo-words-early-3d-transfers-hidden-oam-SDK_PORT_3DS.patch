diff --git a/src/gfd_vram_transfer_manager.c b/src/gfd_vram_transfer_manager.c
index 9783e7a..81de57d 100644
--- a/src/gfd_vram_transfer_manager.c
+++ b/src/gfd_vram_transfer_manager.c
@@ -248,12 +248,45 @@ void NNS_GfdDoVramTransfer(void) {
         return;
     }
     do {
+#ifdef SDK_PORT_3DS
+        /* Done already (NNSi_GfdDoVramTransfer3D). */
+        if (task->pSrc != NULL) {
+            DoTransfer_(task);
+        }
+#else
         DoTransfer_(task);
+#endif
         queue->totalSize -= task->szByte;
         task = NNSi_GfdGetFrontVramTransferTaskQueue(queue);
     } while (NNSi_GfdPopVramTransferTaskQueue(queue));
 }
 
+#ifdef SDK_PORT_3DS
+/* The 3DS port draws a 3D scene when the game ends its frame (OS_Halt), before the
+ * V-blank work that does the transfers queued in that frame; the DS 3D engine draws it
+ * after. The queued texture, texture palette and clear image transfers are done then
+ * instead, from OS_Halt through the port (3ds_port/nitro/src/port_os.c), so a texture
+ * a scene uses for the first time is there when it is drawn. Each is marked done
+ * (pSrc NULL) and skipped by NNS_GfdDoVramTransfer, which still takes it off the queue
+ * and its size off the total, at the V-blank as on the DS. The 2D transfers wait for
+ * the V-blank. Platinum NitroSystem 0004. */
+void NNSi_GfdDoVramTransfer3D(void) {
+    VramTransferTaskQueue *queue = &gVramTransferTaskQueue;
+    u16 idx = queue->idxFront;
+    u16 n;
+
+    for (n = 0; n < queue->numTasks; n++) {
+        NNSGfdVramTransferTask *task = &queue->pTaskArray[idx];
+
+        if (task->pSrc != NULL && task->type < NNS_GFD_DST_2D_BG0_CHAR_MAIN) {
+            DoTransfer_(task);
+            task->pSrc = NULL;
+        }
+        idx = GetNextIndex_(queue, idx);
+    }
+}
+#endif
+
 BOOL NNS_GfdRegisterNewVramTransferTask(NNS_GFD_DST_TYPE type, u32 dstAddr, void *pSrc, u32 szByte) {
     VramTransferTaskQueue *queue = &gVramTransferTaskQueue;
     NNSGfdVramTransferTask *task;
