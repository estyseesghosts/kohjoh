From 483f9262c7cdb6b7b7eb0a6a662e8b12a645e665 Mon Sep 17 00:00:00 2001
From: pokeheartgold-3ds-bootstrap <bootstrap@invalid>
Date: Sat, 31 Oct 2026 06:22:26 +0000
Subject: [PATCH] nns: GXFIFO words, early 3D transfers and hidden OAM entries
 (SDK_PORT_3DS)

NitroSystem behavior hooks for the port. The DS text is unchanged: gcc-10 -E
-P of each file without SDK_PORT_3DS (with -DSDK_ARM9) has 0 diff lines
against the file before this patch. Rebased from Platinum NitroSystem patches
0001-0005; every hunk was checked against the HGSS tree, whose NitroSystem is
a different revision (flat src/, smaller files), so most do not apply:

- 0001 (GCC build fixes): no equivalent needed. The seven hunks touch
  g2d_Data.h (NNS_G2D_UNPACK_OFFSET_PTR), g2di_Char.h (wchar_t NNSG2dChar),
  g2d_CharCanvas.c (__alloca, two sequence points), g2di_BGManipulator.c
  (BGCNT table), g2di_SplitChar.c (wchar_t/UTF-16), gfd_FrameTexVramMan.c
  (implicit int) and sndarc_stream.c (post-increment assign): none of those
  constructs exist in the HGSS files (no UNPACK macro, no NNSG2dChar or
  wchar_t use, no alloca, no MapScrToChar-style *pScr++ reads, no implicit
  int, no AdpcmState increment). The whole of lib/NitroSystem already parses
  under the survey flags (the 15 failing survey files are all NitroSDK).
- 0002 (capture divide by zero): N/A. HGSS capture is its own 121-line
  snd_capture.c with no bufLen/interval division; no NNSi_SndCaptureStart of
  that shape exists anywhere in the tree.
- 0003 (GXFIFO stores): g3d_gecom.c NNS_G3dGeBufferOP_N sends its opcode word
  through NitroPort_GxFifoWord, and all eleven single-register
  reg_G3X_GXFIFO stores in g3d_sbc.c do the same. Bulk sends through
  MIi_CpuSend32 need no hook: the port MI layer already forwards GXFIFO-range
  writes (3ds_port/nitro/src/mi_memory.c). HGSS packs opcodes with shifts
  rather than GX_PACK_OP; the hooked values are identical either way.
- 0004 (3D transfers early): gfd_vram_transfer_manager.c gains
  NNSi_GfdDoVramTransfer3D, which runs the queued texture/palette/clear-image
  tasks (type < NNS_GFD_DST_2D_BG0_CHAR_MAIN, the same boundary as Platinum)
  and marks them done, and NNS_GfdDoVramTransfer skips marked tasks while
  still popping them and subtracting their size. The header declares the new
  function (in patch 1402). No OS_Halt change is needed: the vendored
  port_os.c already calls it (weak). HGSS difference: single global queue
  gVramTransferTaskQueue rather than a manager struct.
- 0005 (OAM hide): NNS_G2dResetOamManagerBuffer parks unused entries with
  (192 | 0x0200) instead of 0xc0 under SDK_PORT_3DS, in both the fill and the
  attr0 paths. HGSS writes the literal 0xc0 (Platinum used a macro); only the
  reset function is changed, not the module-init fills (follow-up).

Tests: tests/sdk/nns_port/run.sh builds the three files with the survey flags
and runs 31 checks: the BufferOP_N opcode word plus its bulk send, the
halt-then-vblank transfer sequence with all four 3D kinds (done once, never
redone, queue reusable), and both OAM reset paths plus the DMA fill value.
Against the tree without this patch the suite fails to link on
NNSi_GfdDoVramTransfer3D.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/g2d_oam.c                   | 15 ++++++++--
 src/g3d_gecom.c                 |  8 ++++++
 src/g3d_sbc.c                   | 51 +++++++++++++++++++++++++++++++++
 src/gfd_vram_transfer_manager.c | 33 +++++++++++++++++++++
 4 files changed, 104 insertions(+), 3 deletions(-)

diff --git a/src/g2d_oam.c b/src/g2d_oam.c
index 8c96e7e..c89376d 100644
--- a/src/g2d_oam.c
+++ b/src/g2d_oam.c
@@ -200,6 +200,15 @@ void NNS_G2dApplyOamManagerToHW(OamManagerInstance *pMan) {
     }
 }
 
+#ifdef SDK_PORT_3DS
+// Unused OAM entries are parked at y 192 on the DS, under the visible screen; on the
+// port taller lower screen those lines show, so hide the entries outright (attr0
+// disable bit): on the DS they do not show either way. Platinum NitroSystem 0005.
+#define OAM_SETTING_INVISIBLE   (192 | 0x0200)
+#else
+#define OAM_SETTING_INVISIBLE   0xc0
+#endif
+
 void NNS_G2dResetOamManagerBuffer(OamManagerInstance *pMan) {
     u8 *oam;
     if (pMan->useFastTransfer) {
@@ -209,9 +218,9 @@ void NNS_G2dResetOamManagerBuffer(OamManagerInstance *pMan) {
         oam = (u8 *)addr;
         DC_InvalidateRange(oam, szByte);
         if (GXi_DmaId != (u32)-1) { // -1: no DMA channel
-            MI_DmaFill32(GXi_DmaId, oam, 0xc0, szByte);
+            MI_DmaFill32(GXi_DmaId, oam, OAM_SETTING_INVISIBLE, szByte);
         } else {
-            MIi_CpuClear32(0xc0, (void *)oam, szByte);
+            MIi_CpuClear32(OAM_SETTING_INVISIBLE, (void *)oam, szByte);
         }
     } else {
         u16 n;
@@ -221,7 +230,7 @@ void NNS_G2dResetOamManagerBuffer(OamManagerInstance *pMan) {
         oam = (u8 *)addr;
         n = pMan->oam.last - pMan->oam.first + 1;
         for (; i < n; i++, oam += 8) {
-            ((GXOamAttr *)oam)->attr0 = 0xc0;
+            ((GXOamAttr *)oam)->attr0 = OAM_SETTING_INVISIBLE;
         }
     }
     pMan->oam.next = pMan->oam.first;
