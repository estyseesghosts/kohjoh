From 2a283a79a64d67d72d3ee6b557bebf99b23b3762 Mon Sep 17 00:00:00 2001
From: impl <impl@invalid>
Date: Sat, 31 Oct 2026 02:30:39 +0000
Subject: [PATCH] nns: GCC count-leading-zeros for g2d canvas helpers
 (SDK_PORT_3DS)

Three copies of the same static inline CountLeadingZeros(u32 x) use
MWCC inline asm `asm { clz x, x }`, which GCC cannot parse:

  lib/NitroSystem/src/g2d_canvas_arrange.c:65    (block lines 63-68)
  lib/NitroSystem/src/g2d_char_canvas.c:372      (block lines 370-375)
  lib/NitroSystem/src/g2d_char_canvas_util.c:8   (block lines 6-11)

The signatures are identical (u32 -> u32), so each copy is replaced
locally; no shared header is added.

What MWCC does: the asm is the ARM CLZ instruction, so CountLeadingZeros(0)
is 32 and for any other x it is the number of leading zero bits (31 for
x == 1, 0 for x >= 0x80000000). GCC's __builtin_clz(0) is undefined, so the
GCC branch tests for zero first and returns 32 for it. Every other input
uses __builtin_clz, which gives the same count.

Each copy now sits under #ifdef SDK_PORT_3DS with the new C body; the
original asm stays under #else, so MWCC compiles the original text.

Log2Max3 and LOG2_CHARS pass their size to this helper, so a size of 0 must
keep the MWCC value 32. The GCC branch keeps it.

Test: tests/sdk/nns_clz/run.sh <patched-root> (port repo) compiles each
patched helper with -m32 -DSDK_PORT_3DS and checks 0, 1, 0x80000000,
0xFFFFFFFF, every single-bit input, and a random sweep against a reference.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/g2d_canvas_arrange.c   | 7 +++++++
 src/g2d_char_canvas.c      | 7 +++++++
 src/g2d_char_canvas_util.c | 7 +++++++
 3 files changed, 21 insertions(+)

diff --git a/src/g2d_canvas_arrange.c b/src/g2d_canvas_arrange.c
index e880211..cb929af 100644
--- a/src/g2d_canvas_arrange.c
+++ b/src/g2d_canvas_arrange.c
@@ -61,10 +61,17 @@ u32 NNSi_G2dCalcRequiredOBJ(u32 areaWidth, u32 areaHeight) {
 }
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+// GCC has no MWCC asm. CLZ gives 32 for a zero input, and __builtin_clz(0) is undefined, so test for zero first.
+static inline u32 CountLeadingZeros(u32 x) {
+    return (x != 0) ? (u32)__builtin_clz(x) : 32;
+}
+#else
 static inline u32 CountLeadingZeros(u32 x) {
     asm { clz x, x }
     return x;
 }
+#endif
 // clang-format on
 
 // log2 of n, at most 3
diff --git a/src/g2d_char_canvas.c b/src/g2d_char_canvas.c
index 813d523..f71384d 100644
--- a/src/g2d_char_canvas.c
+++ b/src/g2d_char_canvas.c
@@ -368,10 +368,17 @@ void NNS_G2dCharCanvasInitForBG(G2dCharCanvas *pCC, void *pCharBase, int areaWid
 #pragma force_active on
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+// GCC has no MWCC asm. CLZ gives 32 for a zero input, and __builtin_clz(0) is undefined, so test for zero first.
+static inline u32 CountLeadingZeros(u32 x) {
+    return (x != 0) ? (u32)__builtin_clz(x) : 32;
+}
+#else
 static inline u32 CountLeadingZeros(u32 x) {
     asm { clz x, x }
     return x;
 }
+#endif
 // clang-format on
 
 // log2 of n, at most 3
diff --git a/src/g2d_char_canvas_util.c b/src/g2d_char_canvas_util.c
index 74cdca8..a1e57f4 100644
--- a/src/g2d_char_canvas_util.c
+++ b/src/g2d_char_canvas_util.c
@@ -4,10 +4,17 @@
 #pragma force_active on
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+// GCC has no MWCC asm. CLZ gives 32 for a zero input, and __builtin_clz(0) is undefined, so test for zero first.
+static inline u32 CountLeadingZeros(u32 x) {
+    return (x != 0) ? (u32)__builtin_clz(x) : 32;
+}
+#else
 static inline u32 CountLeadingZeros(u32 x) {
     asm { clz x, x }
     return x;
 }
+#endif
 // clang-format on
 
 // log2 of a size in characters, at most 3
