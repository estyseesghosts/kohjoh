+// SDK_PORT_3DS: signature match for dgt.h (3ds_port/nitro/src/dgt.c). This file is port-replaced
+// (the port builds dgt.c instead); the guard keeps the survey parse under the macro identical.
+void DGT_Hash1SetSource(struct DGTHash1Context *context, const void *input, unsigned long length) {
+#else
 void DGT_Hash1SetSource(struct DGTHash1Context *context, u8 *input, u32 length) {
+#endif
     const u8 *src = input;
     u32 used = (u32)context->length & 63;
     u32 remaining = 64 - used;
@@ -81,7 +87,11 @@ void DGT_Hash1SetSource(struct DGTHash1Context *context, u8 *input, u32 length)
 }
 
 // Pads the message (0x80, zeros, the bit length), writes the digest and clears the context.
+#ifdef SDK_PORT_3DS
+void DGT_Hash1GetDigest_R(void *digest, struct DGTHash1Context *context) {
+#else
 void DGT_Hash1GetDigest_R(u8 *digest, struct DGTHash1Context *context) {
+#endif
     u64 bits = context->length << 3;
     u32 high = (u32)(bits >> 32);
     u32 low = (u32)bits;
@@ -157,7 +167,11 @@ void DGT_Hash2Reset(struct DGTHash2Context *context) {
     context->Message_Block_Index = 0;
 }
 
+#ifdef SDK_PORT_3DS
+void DGT_Hash2SetSource(struct DGTHash2Context *context, const unsigned char *input, unsigned long length) {
+#else
 void DGT_Hash2SetSource(struct DGTHash2Context *context, u8 *input, u32 length) {
+#endif
     const u8 *src = input;
     u8 *block = context->Message_Block;
     u32 n;
