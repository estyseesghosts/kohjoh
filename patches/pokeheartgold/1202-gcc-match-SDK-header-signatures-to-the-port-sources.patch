diff --git a/lib/NitroSDK/include/dgt.h b/lib/NitroSDK/include/dgt.h
index 793dac8..ca162ce 100644
--- a/lib/NitroSDK/include/dgt.h
+++ b/lib/NitroSDK/include/dgt.h
@@ -18,6 +18,34 @@ struct DGTHash1Context {
 };
 
 struct DGTHash2Context {
+#ifdef SDK_PORT_3DS
+    // SDK_PORT_3DS: 3ds_port/nitro/src/dgt.c works the ntrtwl fields (h0..h4, Nl, Nh, num, data,
+    // dummy) while MATH_CalcSHA1 (via MATH_dgt.c) and the DS game use the HGSS fields below.
+    // Both live in one anonymous union, so both spellings compile against this single header and
+    // share one layout: each member is 104 bytes, so sizeof(struct DGTHash2Context) is unchanged
+    // (verified by tests/sdk/gcc_fixes).
+    union {
+        struct {
+            unsigned long h0, h1, h2, h3, h4;
+            unsigned long Nl, Nh;
+            int num;
+            unsigned long data[64 / 4];
+            int dummy[2];
+        };
+        struct {
+            unsigned long Intermediate_Hash[5];
+            unsigned long Length_Low;
+            unsigned long Length_High;
+            int Message_Block_Index;
+            union {
+                unsigned char Message_Block[64];
+                unsigned long Message_Block_Words[16];
+            };
+            int Computed;
+            int Corrupted;
+        };
+    };
+#else
     unsigned long Intermediate_Hash[5];
     unsigned long Length_Low;
     unsigned long Length_High;
@@ -28,13 +56,27 @@ struct DGTHash2Context {
     };
     int Computed;
     int Corrupted;
+#endif
 };
 
+#ifdef SDK_PORT_3DS
+// SDK_PORT_3DS: 3ds_port/nitro/src/dgt.c defines DGT_Hash1SetSource with (const void *, unsigned
+// long), DGT_Hash1GetDigest_R with (void *, ...) and DGT_Hash2SetSource with (const unsigned
+// char *, unsigned long). The DS u8 * parameters are a different type under GCC, so they conflict
+// with the port definitions. (u32 is unsigned long, so the length spelling alone already agrees.)
+void DGT_Hash1Reset(struct DGTHash1Context *context);
+void DGT_Hash1SetSource(struct DGTHash1Context *context, const void *input, unsigned long length);
+void DGT_Hash1GetDigest_R(void *digest, struct DGTHash1Context *context);
+void DGT_Hash2Reset(struct DGTHash2Context *context);
+void DGT_Hash2SetSource(struct DGTHash2Context *context, const unsigned char *input, unsigned long length);
+void DGT_Hash2GetDigest(struct DGTHash2Context *context, u8 *digest);
+#else
 void DGT_Hash1Reset(struct DGTHash1Context *context);
 void DGT_Hash1SetSource(struct DGTHash1Context *context, u8 *input, u32 length);
 void DGT_Hash1GetDigest_R(u8 *digest, struct DGTHash1Context *context);
 void DGT_Hash2Reset(struct DGTHash2Context *context);
 void DGT_Hash2SetSource(struct DGTHash2Context *context, u8 *input, u32 length);
 void DGT_Hash2GetDigest(struct DGTHash2Context *context, u8 *digest);
+#endif
 
 #endif
