@@ -23,8 +23,29 @@ typedef struct NVRAMConfigComment
 
 typedef struct NVRAMConfigOwnerInfo
 {
+#ifdef SDK_PORT_3DS
+    // SDK_PORT_3DS: 3ds_port/nitro/src/port_boot.c:46 spells this favoriteColor; the SDK and the DS
+    // game spell it favouriteColour (as does lib/NitroSDK/src/os/os_ownerInfo.c:10, which the port
+    // still compiles, and OSOwnerInfo itself has a member named favoriteColor, so a #define is out).
+    // Both names address the same bits: the union wraps the whole bitfield run, so the layout and
+    // sizeof are unchanged (verified by tests/sdk/gcc_fixes).
+    union
+    {
+        struct
+        {
+            u8 favoriteColor:4;   //0x00 (0-3)
+            u8 rsv:4;             //0x00 (4-7)
+        };
+        struct
+        {
+            u8 favouriteColour:4; //0x00 (0-3)
+            u8 :4;                //0x00 (4-7)
+        };
+    };
+#else
     u8 favouriteColour:4;         //0x00 (0-3)
     u8 rsv:4;                     //0x00 (4-7)
+#endif
     NVRAMConfigDate birthday;     //0x01
     u8 pad;                       //0x03
     NVRAMConfigNickname nickname; //0x04
@@ -56,6 +77,38 @@ typedef struct NVRAMConfigTpCalibData
 
 typedef struct NVRAMConfigOption
 {
+#ifdef SDK_PORT_3DS
+    // SDK_PORT_3DS: 3ds_port/nitro/src/port_boot.c:55 spells bit 11 input_favoriteColor; the SDK
+    // and the DS game spell it input_favouriteColour (nothing else in the tree reads it, but a
+    // #define is still out: OSOwnerInfo has a member named favoriteColor). Both names address bit
+    // 11 of the same bits: the union wraps the whole bitfield run, so the layout and sizeof are
+    // unchanged (verified by tests/sdk/gcc_fixes). Wrapping only the one bitfield would split the
+    // run into three storage units and change sizeof; every other member keeps its single
+    // declaration in the first struct, so no access is ambiguous.
+    union
+    {
+        struct
+        {
+            u16 language:3;               //0x00 (0-2)
+            u16 agbLcd:1;                 //0x00 (3)
+            u16 detectPullOutCardFlag:1;  //0x00 (4)
+            u16 detectPullOutCtrdgFlag:1; //0x00 (5)
+            u16 autoBootFlag:1;           //0x00 (6)
+            u16 rsv:4;                    //0x00 (7-10)
+            u16 input_favoriteColor:1;    //0x00 (11)
+            u16 input_tp:1;               //0x00 (12)
+            u16 input_language:1;         //0x00 (13)
+            u16 input_rtc:1;              //0x00 (14)
+            u16 input_nickname:1;         //0x00 (15)
+        };
+        struct
+        {
+            u16 :11;                      //0x00 (0-10)
+            u16 input_favouriteColour:1;  //0x00 (11)
+            u16 :4;                       //0x00 (12-15)
+        };
+    };
+#else
     u16 language:3;               //0x00 (0-2)
     u16 agbLcd:1;                 //0x00 (3)
     u16 detectPullOutCardFlag:1;  //0x00 (4)
@@ -67,6 +120,7 @@ typedef struct NVRAMConfigOption
     u16 input_language:1;         //0x00 (13)
     u16 input_rtc:1;              //0x00 (14)
     u16 input_nickname:1;         //0x00 (15)
+#endif
     u8 timeZone;                  //0x02
     u8 rtcClockAdjust;            //0x03
     s64 rtcOffset;                //0x04
