--- a/lib/include/nitro/pxi/fifo.h
+++ b/lib/include/nitro/pxi/fifo.h
@@ -26,10 +26,23 @@ typedef union
     u32 raw;
 } PXIFifoMessage;
 
+#ifdef SDK_PORT_3DS
+// SDK_PORT_3DS: 3ds_port/nitro/src/pxi.c defines these with int tags (s32 is long, a different type
+// from int under GCC even with -m32) and adds PXI_SetFifoSendCallback, whose PXIFifoEmtpyCallback
+// keeps the SDK-side spelling the port uses. MWCC accepts either.
+typedef void (*PXIFifoEmtpyCallback)(void);
+void PXI_InitFifo(void);
+void PXI_SetFifoRecvCallback(int fifotag, PXIFifoCallback callback);
+BOOL PXI_IsCallbackReady(int fifotag, PXIProc proc);
+int PXI_SendWordByFifo(int fifotag, u32 data, BOOL err);
+void PXI_SetFifoSendCallback(PXIFifoEmtpyCallback callback);
+void PXIi_HandlerRecvFifoNotEmpty(void);
+#else
 void PXI_InitFifo(void);
 void PXI_SetFifoRecvCallback(s32 fifotag, PXIFifoCallback callback);
 BOOL PXI_IsCallbackReady(s32 fifotag, PXIProc proc);
 s32 PXI_SendWordByFifo(s32 fifotag, u32 data, BOOL err);
 void PXIi_HandlerRecvFifoNotEmpty(void);
+#endif
 
 #endif //NITRO_PXI_FIFO_H_
diff --git a/lib/include/nitro/spi/userInfo.h b/lib/include/nitro/spi/userInfo.h
