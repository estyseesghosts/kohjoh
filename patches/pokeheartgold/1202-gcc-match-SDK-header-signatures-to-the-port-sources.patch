diff --git a/lib/NitroSDK/include/CARD_common.h b/lib/NitroSDK/include/CARD_common.h
index 1ae31b7..9eaceb9 100644
--- a/lib/NitroSDK/include/CARD_common.h
+++ b/lib/NitroSDK/include/CARD_common.h
@@ -115,7 +115,18 @@ typedef struct CARDiCommandArg
     CARDBackupType type;
     u32 id;
     u32 src;
+#ifdef SDK_PORT_3DS
+    // SDK_PORT_3DS: 3ds_port/nitro/src/port_card.c spells this dst (ntrtwl's name); the SDK and
+    // the DS game spell it dest. Both names address the same word: the union keeps the offset
+    // and sizeof(CARDiCommandArg) identical (verified by tests/sdk/gcc_fixes).
