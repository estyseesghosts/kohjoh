--- a/src/application/battle_room_results.c
+++ b/src/application/battle_room_results.c
@@ -535,7 +535,11 @@ static void BattleRoomResults_SetGfxBanks(void) {
 static void BattleRoomResults_VBlankCB(BattleRoomResults *results) {
     BattleRoomResults_TransferOam();
     DoScheduledBgGpuUpdates(results->bgConfig);
+#ifdef SDK_PORT_3DS
+    ((u32 *)HW_DTCM)[(HW_INTR_CHECK_BUF - HW_DTCM) / 4] |= OS_IE_V_BLANK; // OS_SetIrqCheckFlag
+#else
     ((u32 *)0x027E0000)[(HW_INTR_CHECK_BUF - HW_DTCM) / 4] |= OS_IE_V_BLANK; // OS_SetIrqCheckFlag
+#endif
 }
 
