+++ b/src/field/encounter_effect_particles.c
@@ -58,8 +58,12 @@ void EncounterEffect_StartParticleMode(FieldSystem *fieldSystem) {
     GfGfx_EngineATogglePlanes(GX_PLANEMASK_BG2, GF_PLANE_TOGGLE_OFF);
     GfGfx_EngineATogglePlanes(GX_PLANEMASK_BG3, GF_PLANE_TOGGLE_OFF);
     GX_ResetBankForBG();
-    MI_CpuClearFast((void *)0x06840000, 0x20000); // VRAM bank D (LCDC)
-    // capture the main screen into VRAM bank D
+#ifdef SDK_PORT_3DS
+    MI_CpuClearFast((void *)(HW_LCDC_VRAM + 0x40000), 0x20000); // VRAM bank C (LCDC)
+#else
+    MI_CpuClearFast((void *)0x06840000, 0x20000); // VRAM bank C (LCDC)
+#endif
+    // capture the main screen into VRAM bank C
     reg_GX_DISPCAPCNT = 0xC0320C04;
     SysTask_CreateOnVWaitQueue(Task_ParticleSetup_VWait, gEncounterEffectState.particles, 1024);
     SysTask_CreateOnMainQueue(Task_ParticleSetup_Main, gEncounterEffectState.particles, 1024);
