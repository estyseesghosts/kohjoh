From ca601fa44325d3fd2ae5bcc82e348bbbbf920a9a Mon Sep 17 00:00:00 2001
From: pokeheartgold-3ds <port@invalid>
Date: Sun, 1 Nov 2026 07:00:36 +0000
Subject: [PATCH 1/4] game: use HW_MAIN_MEM for SystemCard_InitRomArchive
 header mirrors

The DS header mirrors are HW_MAIN_MEM + 0x7FF000/+0x7FFA80/+0x7FF00C; the port main memory is an ordinary array, so the literal addresses crash at frame 0. The DS text is unchanged.
---
 src/system_card.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/system_card.c b/src/system_card.c
index 78785a9..787c8cf 100644
--- a/src/system_card.c
+++ b/src/system_card.c
@@ -9,9 +9,18 @@
 #include <nitro/mi.h>
 #include <nitro/os.h>
 
+#ifdef SDK_PORT_3DS
+/* These are DS addresses in main memory (HW_MAIN_MEM + 0x7FF000,
+ * + 0x7FFA80, + 0x7FF00C). The port main memory is an ordinary array, so
+ * the literals would point at nothing; spell them from HW_MAIN_MEM. */
+#define HW_ROM_HEADER_MIRROR   ((void *)(HW_MAIN_MEM + 0x007FF000))
+#define HW_ROM_HEADER_MIRROR_2 ((void *)(HW_MAIN_MEM + 0x007FFA80))
+#define HW_ROM_HEADER_VALID    ((u32 *)(HW_MAIN_MEM + 0x007FF00C))
+#else
 #define HW_ROM_HEADER_MIRROR   ((void *)0x027FF000)
 #define HW_ROM_HEADER_MIRROR_2 ((void *)0x027FFA80)
 #define HW_ROM_HEADER_VALID    ((u32 *)0x027FF00C)
+#endif
 #define ROM_GAME_CODE          0x4A414441
 #define ROM_MAKER_CODE         0x3130
 
