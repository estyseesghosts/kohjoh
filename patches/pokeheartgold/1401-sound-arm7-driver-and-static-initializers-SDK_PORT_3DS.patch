+++ b/sub/lib/src/sound_command.c
@@ -13,6 +13,13 @@
 
 extern OSMessageQueue sCommandMesgQueue;
 extern OSMessage sCommandMesgBuffer[8];
+#ifdef SDK_PORT_3DS
+/* Sound registers and the audio service entry points. The command queue is owned by
+ * the audio service, never the ARM7 OS (Platinum NitroSDK 0018 and 0019). */
+extern volatile u8 NitroPort_SoundRegisters[];
+extern const struct SNDCommand *NitroPort_SoundPopCommand(void);
+extern void NitroPort_SoundChannelStart(int chNo);
+#endif
 
 // Sound driver entry points called by the command processor (defined in the other sound files).
 u32 SND_GetChannelControl(int c);
@@ -61,16 +68,25 @@ void PxiFifoCallback(PXIFifoTag tag, u32 data, BOOL err);
 #pragma dont_inline on
 
 void SND_CommandInit(void) {
+#ifndef SDK_PORT_3DS
     OS_InitMessageQueue(&sCommandMesgQueue, sCommandMesgBuffer, 8);
     PXI_SetFifoRecvCallback(PXI_FIFO_TAG_SOUND, PxiFifoCallback);
+#endif
     SNDi_SharedWork = NULL;
 }
 
 void SND_CommandProc(void) {
+#ifdef SDK_PORT_3DS
+    const struct SNDCommand *command_p;
+    while ((command_p = NitroPort_SoundPopCommand()) != NULL) {
+        volatile u8 *cap1 = &NitroPort_SoundRegisters[0x109], *cap0 = cap1 - 1;
+        struct SNDCommand *list = (struct SNDCommand *)command_p;
+#else
     OSMessage message;
     while (OS_ReceiveMessage(&sCommandMesgQueue, &message, OS_MESSAGE_NOBLOCK)) {
         volatile u8 *cap1 = (volatile u8 *)0x04000509, *cap0 = cap1 - 1;
         struct SNDCommand *list = (struct SNDCommand *)message;
+#endif
         while (list) {
             struct SNDCommand cmd = *list;
             switch (cmd.id) {
@@ -119,7 +135,14 @@ void SND_CommandProc(void) {
                 int i;
                 for (i = 0; i < 16 && channels; i++, channels >>= 1) {
                     if (channels & 1) {
+#ifdef SDK_PORT_3DS
+                        volatile u8 *ctrl = &NitroPort_SoundRegisters[3 + (u32)i * 16];
+                        if (!(*ctrl & 128)) {
+                            NitroPort_SoundChannelStart(i);
+                        }
+#else
                         volatile u8 *ctrl = (volatile u8 *)(0x04000403 + (u32)i * 16);
+#endif
                         *ctrl |= 128;
                     }
                 }
@@ -213,7 +236,11 @@ void SND_CommandProc(void) {
                 break;
             }
             case SND_CMD_SETUP_CHANNEL_PCM:
+#ifdef SDK_PORT_3DS
+                SND_SetupChannelPcm((u16)cmd.arg[0], cmd.arg[1], (cmd.arg[3] >> 24) & 3, (cmd.arg[3] >> 26) & 3, (u16)cmd.arg[3], cmd.arg[2] & 0x3fffff, (cmd.arg[2] >> 24) & 127, (cmd.arg[2] >> 22) & 3, (u16)(cmd.arg[0] >> 16), (cmd.arg[3] >> 16) & 127);
+#else
                 SND_SetupChannelPcm((u16)cmd.arg[0], cmd.arg[1] & 0x7ffffff, (cmd.arg[3] >> 24) & 3, (cmd.arg[3] >> 26) & 3, (u16)cmd.arg[3], cmd.arg[2] & 0x3fffff, (cmd.arg[2] >> 24) & 127, (cmd.arg[2] >> 22) & 3, (u16)(cmd.arg[0] >> 16), (cmd.arg[3] >> 16) & 127);
+#endif
                 break;
             case SND_CMD_SETUP_CHANNEL_PSG:
                 SND_SetupChannelPsg(cmd.arg[0], cmd.arg[3], cmd.arg[1] & 127, (cmd.arg[1] >> 8) & 3, (cmd.arg[2] >> 8) & 65535, cmd.arg[2] & 127);
@@ -267,7 +294,11 @@ void SND_CommandProc(void) {
             }
             list = cmd.llNext;
         }
+#ifdef SDK_PORT_3DS
+        (void)__atomic_add_fetch(&SNDi_SharedWork->finishedCommandTag, 1, __ATOMIC_RELEASE);
+#else
         SNDi_SharedWork->finishedCommandTag++;
+#endif
     }
 }
 
