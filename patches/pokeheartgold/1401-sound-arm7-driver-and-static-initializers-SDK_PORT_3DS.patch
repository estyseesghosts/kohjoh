diff --git a/lib/NitroSDK/src/snd/SND_work.c b/lib/NitroSDK/src/snd/SND_work.c
index bd3b11f..790d530 100644
--- a/lib/NitroSDK/src/snd/SND_work.c
+++ b/lib/NitroSDK/src/snd/SND_work.c
@@ -4,28 +4,69 @@
 #include "OS_cache.h"
 #include "nitro/types.h"
 #include "code32.h"
+#ifdef SDK_PORT_3DS
+/* All ARM7 writes run under the port audio spinlock. The ARM9 getters take the same
+ * lock to read shared player and command state (3ds_port/nitro/src/port_snd.c).
+ * Platinum NitroSDK 0022. */
+extern void NitroPort_SoundSharedLock(void);
+extern void NitroPort_SoundSharedUnlock(void);
+#endif
+
 
 struct SNDSharedWork *SNDi_SharedWork;
 
+#ifdef SDK_PORT_3DS
+u32 SND_GetPlayerStatus(void) {
+    u32 value;
+    DC_InvalidateRange(&SNDi_SharedWork->playerStatus, 4);
+    NitroPort_SoundSharedLock();
+    value = SNDi_SharedWork->playerStatus;
+    NitroPort_SoundSharedUnlock();
+    return value;
+}
+#else
 u32 SND_GetPlayerStatus(void) {
     DC_InvalidateRange(&SNDi_SharedWork->playerStatus, 4);
     return SNDi_SharedWork->playerStatus;
 }
+#endif
 
+#ifdef SDK_PORT_3DS
+u16 SND_GetChannelStatus(void) {
+    u16 value;
+    DC_InvalidateRange(&SNDi_SharedWork->channelStatus, 2);
+    NitroPort_SoundSharedLock();
+    value = SNDi_SharedWork->channelStatus;
+    NitroPort_SoundSharedUnlock();
+    return value;
+}
+#else
 u16 SND_GetChannelStatus(void) {
     DC_InvalidateRange(&SNDi_SharedWork->channelStatus, 2);
     return SNDi_SharedWork->channelStatus;
 }
+#endif
 
 //u16 SND_GetCaptureStatus(void) {
 //    DC_InvalidateRange(&SNDi_SharedWork->captureStatus, 2);
 //    return SNDi_SharedWork->captureStatus;
 //}
 
+#ifdef SDK_PORT_3DS
+u32 SND_GetPlayerTickCounter(u32 playerId) {
+    u32 value;
+    DC_InvalidateRange(&SNDi_SharedWork->players[playerId].tickCounter, 4);
+    NitroPort_SoundSharedLock();
+    value = SNDi_SharedWork->players[playerId].tickCounter;
+    NitroPort_SoundSharedUnlock();
+    return value;
+}
+#else
 u32 SND_GetPlayerTickCounter(u32 playerId) {
     DC_InvalidateRange(&SNDi_SharedWork->players[playerId].tickCounter, 4);
     return SNDi_SharedWork->players[playerId].tickCounter;
 }
+#endif
 
 //s16 SND_GetPlayerLocalVariable(u32 playerId, u32 var) {
 //    DC_InvalidateRange(&SNDi_SharedWork->players[playerId].localVars[var], 2);
@@ -89,10 +130,21 @@ u32 SND_GetPlayerTickCounter(u32 playerId) {
 //    return TRUE;
 //}
 
+#ifdef SDK_PORT_3DS
+u32 SNDi_GetFinishedCommandTag(void) {
+    u32 value;
+    DC_InvalidateRange(&SNDi_SharedWork->finishedCommandTag, 4);
+    NitroPort_SoundSharedLock();
+    value = SNDi_SharedWork->finishedCommandTag;
+    NitroPort_SoundSharedUnlock();
+    return value;
+}
+#else
 u32 SNDi_GetFinishedCommandTag(void) {
     DC_InvalidateRange(&SNDi_SharedWork->finishedCommandTag, 4);
     return SNDi_SharedWork->finishedCommandTag;
 }
+#endif
 
 void SNDi_InitSharedWork(struct SNDSharedWork *sw) {
     sw->playerStatus = 0;
diff --git a/lib/dsprot/include/static_init.h b/lib/dsprot/include/static_init.h
index 8857965..2b9c740 100644
--- a/lib/dsprot/include/static_init.h
+++ b/lib/dsprot/include/static_init.h
@@ -3,9 +3,17 @@
 
 // Registers this file's NitroStaticInit in .sinit, to run when the overlay loads.
 static void NitroStaticInit(void);
+#ifdef SDK_PORT_3DS
+/* GCC section attribute instead of the MWCC section pragmas (Platinum 0027). The
+ * game build gathers the overlay's pointers into a table of its own, and FS_StartOverlay
+ * calls them once the overlay is loaded. */
+__attribute__((section(".sinit"), used))
+static void (*NitroStaticInit_[])(void) = { NitroStaticInit };
+#else
 #pragma define_section SINIT ".sinit" abs32 RWX
 #pragma section SINIT begin
 SDK_FORCE_EXPORT static void (*NitroStaticInit_[])(void) = { NitroStaticInit };
 #pragma section SINIT end
+#endif
 
 #endif // DSPROT_STATIC_INIT_H
diff --git a/sub/lib/src/sound_alarm.c b/sub/lib/src/sound_alarm.c
index 9a7b4d0..f27f11e 100644
--- a/sub/lib/src/sound_alarm.c
+++ b/sub/lib/src/sound_alarm.c
@@ -13,6 +13,12 @@
 
 // Not declared by the OS_*.h headers used with the SND_*_shared.h types.
 void OS_SetPeriodicAlarm(OSAlarm *alarm, OSTick start, OSTick period, OSAlarmHandler handler, void *arg);
+#ifdef SDK_PORT_3DS
+/* Stream alarms run on the port audio clock (3ds_port/nitro/src/port_snd.c). Ticks are
+ * OS ticks, as in the SDK. Platinum NitroSDK 0020. */
+extern void NitroPort_SoundAlarmStart(int alarmNo, u64 tick, u64 period, u32 id);
+extern void NitroPort_SoundAlarmStop(int alarmNo);
+#endif
 
 void SND_AlarmInit(void);
 void SND_SetupAlarm(int index, OSTick tick, OSTick period, int id);
@@ -34,7 +40,11 @@ void SND_AlarmInit(void) {
 void SND_SetupAlarm(int index, OSTick tick, OSTick period, int id) {
     struct SNDAlarm *alarm = &SNDi_Work.alarms[index];
     if (alarm->enable) {
+#ifdef SDK_PORT_3DS
+        NitroPort_SoundAlarmStop(index);
+#else
         OS_CancelAlarm(&alarm->alarm);
+#endif
         alarm->enable = 0;
     }
     alarm->tick = tick;
@@ -47,25 +57,37 @@ void SND_StartAlarm(int index) {
     struct SNDAlarm *alarm = &SNDi_Work.alarms[index];
     u32 arg;
     if (alarm->enable) {
+#ifdef SDK_PORT_3DS
+        NitroPort_SoundAlarmStop(index);
+#else
         OS_CancelAlarm(&alarm->alarm);
+#endif
         alarm->enable = 0;
     }
     period = alarm->period;
     tick = alarm->tick;
     arg = index | ((u32)alarm->id << 8);
+#ifdef SDK_PORT_3DS
+    NitroPort_SoundAlarmStart(index, tick, period, arg);
+#else
     OS_CreateAlarm(&alarm->alarm);
     if (!period) {
         OS_SetAlarm(&alarm->alarm, tick, AlarmHandler, (void *)arg);
     } else {
         OS_SetPeriodicAlarm(&alarm->alarm, OS_GetTick() + tick, period, AlarmHandler, (void *)arg);
     }
+#endif
     alarm->enable = 1;
 }
 
 void SND_StopAlarm(int index) {
     struct SNDAlarm *alarm = &SNDi_Work.alarms[index];
     if (alarm->enable) {
+#ifdef SDK_PORT_3DS
+        NitroPort_SoundAlarmStop(index);
+#else
         OS_CancelAlarm(&alarm->alarm);
+#endif
         alarm->id++;
         alarm->enable = 0;
     }
diff --git a/sub/lib/src/sound_channel.c b/sub/lib/src/sound_channel.c
index 8f242ee..3b88cd8 100644
--- a/sub/lib/src/sound_channel.c
+++ b/sub/lib/src/sound_channel.c
@@ -7,6 +7,17 @@
 #define R8(c, o)  (*(volatile u8 *)(0x04000000u + ((u32)(c) << 4) + (o)))
 #define R16(c, o) (*(volatile u16 *)(0x04000000u + ((u32)(c) << 4) + (o)))
 #define R32(c, o) (*(volatile u32 *)(0x04000000u + ((u32)(c) << 4) + (o)))
+#ifdef SDK_PORT_3DS
+/* Channel registers live in the port sound array (3ds_port/nitro/src/port_sound_chip.c),
+ * indexed from 0x04000400. Platinum NitroSDK 0018. */
+extern volatile u8 NitroPort_SoundRegisters[];
+#undef R8
+#undef R16
+#undef R32
+#define R8(c, o)  (*(volatile u8 *)(&NitroPort_SoundRegisters[((u32)(c) << 4) + (o) - 0x400]))
+#define R16(c, o) (*(volatile u16 *)(&NitroPort_SoundRegisters[((u32)(c) << 4) + (o) - 0x400]))
+#define R32(c, o) (*(volatile u32 *)(&NitroPort_SoundRegisters[((u32)(c) << 4) + (o) - 0x400]))
+#endif
 
 typedef struct SoundChannelRegisters {
     volatile u32 control;
@@ -84,9 +95,17 @@ void SND_SetupChannelPsg(int c, int duty, int volume, int shift, int timer, int
     }
     {
         u32 control = ((u32)duty << 24) | 0x60000000u | ((u32)pan << 16) | ((u32)shift << 8);
+#ifdef SDK_PORT_3DS
+        *(volatile u32 *)&NitroPort_SoundRegisters[channelOffset] = (u32)volume | control;
+#else
         *(volatile u32 *)(0x04000400u + channelOffset) = (u32)volume | control;
+#endif
     }
+#ifdef SDK_PORT_3DS
+    *(volatile u16 *)&NitroPort_SoundRegisters[8 + channelOffset] = 0x10000u - (u32)timer;
+#else
     *(volatile u16 *)(0x04000408u + channelOffset) = 0x10000u - (u32)timer;
+#endif
 }
 
 void SND_SetupChannelNoise(int c, int volume, int shift, int timer, int pan) {
@@ -104,13 +123,31 @@ void SND_SetupChannelNoise(int c, int volume, int shift, int timer, int pan) {
     }
     {
         u32 control = ((u32)pan << 16) | 0x60000000u | ((u32)shift << 8);
+#ifdef SDK_PORT_3DS
+        *(volatile u32 *)&NitroPort_SoundRegisters[channelOffset] = (u32)volume | control;
+#else
         *(volatile u32 *)(0x04000400u + channelOffset) = (u32)volume | control;
+#endif
     }
+#ifdef SDK_PORT_3DS
+    *(volatile u16 *)&NitroPort_SoundRegisters[8 + channelOffset] = 0x10000u - (u32)timer;
+#else
     *(volatile u16 *)(0x04000408u + channelOffset) = 0x10000u - (u32)timer;
+#endif
 }
 
 void SND_StopChannel(int c, int flags) {
     u32 offset = (u32)c << 4;
+#ifdef SDK_PORT_3DS
+    /* Same read-modify-write on the channel control word, without the struct overlay
+     * (which is addressed from 0x04000000, outside the sound block). */
+    volatile u32 *reg = (volatile u32 *)&NitroPort_SoundRegisters[offset];
+    u32 value = *reg & ~0x80000000u;
+    if (flags & 1) {
+        value |= 0x8000;
+    }
+    *reg = value;
+#else
     SoundRegisters *input = (SoundRegisters *)(0x04000000u + offset);
     u32 value = input->channels[0].control & ~0x80000000u;
     volatile u32 *output = (volatile u32 *)(offset + 0x400u + 0x04000000u);
@@ -118,6 +155,7 @@ void SND_StopChannel(int c, int flags) {
         value |= 0x8000;
     }
     *output = value;
+#endif
 }
 
 void SND_SetChannelVolume(int c, int volume, int shift) {
@@ -171,9 +209,17 @@ u32 SND_GetChannelControl(int c) {
 
 static inline void ApplyChannelSurroundDecay(int i, const u8 *volume) {
     u32 offset = (u32)i << 4;
+#ifdef SDK_PORT_3DS
+    int pan = NitroPort_SoundRegisters[offset + 2u];
+#else
     int pan = *(volatile u8 *)(0x04000000u + offset + 0x402u);
+#endif
     int value = CalcSurroundDecay(volume[i], pan);
+#ifdef SDK_PORT_3DS
+    NitroPort_SoundRegisters[offset] = value;
+#else
     *(volatile u8 *)(0x04000000u + offset + 0x400u) = value;
+#endif
 }
 
 void SNDi_SetSurroundDecay(int decay) {
diff --git a/sub/lib/src/sound_command.c b/sub/lib/src/sound_command.c
