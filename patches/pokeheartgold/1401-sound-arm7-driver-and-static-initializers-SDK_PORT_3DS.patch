+#ifdef SDK_PORT_3DS
+/* The port sound chip restarts a channel when its enable bit goes 0 to 1, as the DS
+ * hardware does; the driver may stop and start a channel between two of its mixes,
+ * so it is told here (3ds_port/nitro/src/port_snd.c). Platinum NitroSDK 0023. */
+extern volatile u8 NitroPort_SoundRegisters[];
+extern void NitroPort_SoundChannelStart(int chNo);
+#endif
 
 void SND_SetupChannelPcm(int channel, u32 src, int format, int repeat, int loop, u32 length, int volume, int shift, int timer, int pan);
 void SND_SetupChannelPsg(int channel, u32 duty, int volume, int shift, int timer, int pan);
@@ -110,7 +117,15 @@ void SND_UpdateExChannel(void) {
         u32 sync = chn->flags.syncFlag;
         if (sync) {
             if (sync & SND_CHN_SYNC_START) {
+#ifdef SDK_PORT_3DS
+                volatile u8 *enable = &NitroPort_SoundRegisters[3 + (u32)i * 16];
+                if (!(*enable & 0x80)) {
+                    NitroPort_SoundChannelStart(i);
+                }
+                *enable |= 0x80;
+#else
                 *(volatile u8 *)(0x04000403 + i * 16) |= 0x80;
+#endif
