-        reg_G3_MTX_IDENTITY = 0;
+        SPL_G3_WRITE(MTX_IDENTITY, 0);
         G3_MultMtx43(&m);
     } else {
         pos.x = ptcl->ptcl_pos.x + ptcl->emtr_pos.x - mgr->current_state.p_emtr->p_res->p_base->pos.x;
@@ -168,19 +188,19 @@ void spl_draw_bb(SPLManager *mgr, SPLParticle *ptcl) {
         m._30 = pos.x;
