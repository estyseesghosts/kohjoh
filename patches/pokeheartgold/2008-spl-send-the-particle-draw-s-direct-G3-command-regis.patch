From a7869033fa5db49b911261b68fcdc8538b6ade03 Mon Sep 17 00:00:00 2001
From: terezi <jules@foxtails.me>
Date: Tue, 17 Nov 2026 06:29:03 -0500
Subject: [PATCH] spl: send the particle draw's direct G3 command-register
 writes to the port (SDK_PORT_3DS)

spl_draw_ptcl.c stores straight to the G3 command registers (POLYGON_ATTR,
MTX_IDENTITY/TRANS/SCALE, COLOR, TEXCOORD, VTX_10, BEGIN/END_VTXS). On the
port those registers are ordinary memory, so the geometry engine never saw a
particle: every SPL effect (the opening movie's starter grass/fire/water
puffs, battle and field particles) drew nothing. Patch 2004's scan covered
src/ and the SDK/NitroSystem sources but not lib/src.

Under SDK_PORT_3DS the 61 writes go through NitroPort_GxDirectWrite with the
register's opcode via SPL_G3_WRITE; on the DS the macro expands to the
original register store.
---
 lib/src/spl_draw_ptcl.c | 142 +++++++++++++++++++++++-----------------
 1 file changed, 81 insertions(+), 61 deletions(-)

diff --git a/lib/src/spl_draw_ptcl.c b/lib/src/spl_draw_ptcl.c
index 1fb60ed..9e6faa9 100644
--- a/lib/src/spl_draw_ptcl.c
+++ b/lib/src/spl_draw_ptcl.c
@@ -1,21 +1,41 @@
 #include "spl_internal.h"
 
+// Under SDK_PORT_3DS the G3 command registers are ordinary memory and only writes through
+// NitroPort_GxDirectWrite reach the port's geometry engine (see the game-side patch 2004); without
+// this every particle quad was lost and no SPL effect was drawn. The DS build writes the
+// registers as before.
+#ifdef SDK_PORT_3DS
+#define SPL_G3OP_BEGIN_VTXS G3OP_BEGIN
+#define SPL_G3OP_END_VTXS G3OP_END
+#define SPL_G3OP_TEXCOORD G3OP_TEXCOORD
+#define SPL_G3OP_VTX_10 G3OP_VTX_10
+#define SPL_G3OP_MTX_SCALE G3OP_MTX_SCALE
+#define SPL_G3OP_MTX_IDENTITY G3OP_MTX_IDENTITY
+#define SPL_G3OP_MTX_TRANS G3OP_MTX_TRANS
+#define SPL_G3OP_COLOR G3OP_COLOR
+#define SPL_G3OP_POLYGON_ATTR G3OP_POLYGON_ATTR
+#define SPL_G3_WRITE(name, value) NitroPort_GxDirectWrite(SPL_G3OP_##name, (u32)(value))
+#else
+#define SPL_G3_WRITE(name, value) (reg_G3_##name = (value))
+#endif
+
+
 // particle drawing for each draw type, parents and children: billboard (bb), directional billboard
 // (dbb), polygon (pol) and directional polygon (dpl), with the texture set-up, the polygon rotation
 // matrices and the quad drawn in the XY / XZ plane
 
 static inline void TexCoord(fx32 s, fx32 t) {
-    reg_G3_TEXCOORD = (u16)(s >> 8) | ((u16)(t >> 8) << REG_G3_TEXCOORD_DECIMAL_T_SHIFT);
+    SPL_G3_WRITE(TEXCOORD, (u16)(s >> 8) | ((u16)(t >> 8) << REG_G3_TEXCOORD_DECIMAL_T_SHIFT));
 }
 
 static inline void Vtx10(fx16 x, fx16 y, fx16 z) {
-    reg_G3_VTX_10 = ((x >> 6) & 0x3FF) | (((y >> 6) & 0x3FF) << REG_G3_VTX_10_DECIMAL_Y_SHIFT) | (((z >> 6) & 0x3FF) << REG_G3_VTX_10_DECIMAL_Z_SHIFT);
+    SPL_G3_WRITE(VTX_10, ((x >> 6) & 0x3FF) | (((y >> 6) & 0x3FF) << REG_G3_VTX_10_DECIMAL_Y_SHIFT) | (((z >> 6) & 0x3FF) << REG_G3_VTX_10_DECIMAL_Z_SHIFT));
 }
 
 static inline void MtxScale(fx32 x, fx32 y, fx32 z) {
-    reg_G3_MTX_SCALE = x;
-    reg_G3_MTX_SCALE = y;
-    reg_G3_MTX_SCALE = z;
+    SPL_G3_WRITE(MTX_SCALE, x);
+    SPL_G3_WRITE(MTX_SCALE, y);
+    SPL_G3_WRITE(MTX_SCALE, z);
 }
 
 // MWCC 1.2 applies force_active as set at the end of the file and emits a file's functions in
@@ -24,7 +44,7 @@ static inline void MtxScale(fx32 x, fx32 y, fx32 z) {
 
 // a 2x2 quad around (x, y) in the XY plane, texture coordinates up to (s, t)
 void drawXYPlane(fx32 s, fx32 t, fx32 x, fx32 y) {
-    reg_G3_BEGIN_VTXS = GX_BEGIN_QUADS;
+    SPL_G3_WRITE(BEGIN_VTXS, GX_BEGIN_QUADS);
     TexCoord(0, 0);
     Vtx10((fx16)(x - FX32_ONE), (fx16)(y + FX32_ONE), 0);
     TexCoord(s, 0);
@@ -33,12 +53,12 @@ void drawXYPlane(fx32 s, fx32 t, fx32 x, fx32 y) {
     Vtx10((fx16)(x + FX32_ONE), (fx16)(y - FX32_ONE), 0);
     TexCoord(0, t);
     Vtx10((fx16)(x - FX32_ONE), (fx16)(y - FX32_ONE), 0);
-    reg_G3_END_VTXS = 0;
+    SPL_G3_WRITE(END_VTXS, 0);
 }
 
 // a 2x2 quad around (x, z) in the XZ plane, texture coordinates up to (s, t)
 void drawXZPlane(fx32 s, fx32 t, fx32 x, fx32 z) {
-    reg_G3_BEGIN_VTXS = GX_BEGIN_QUADS;
+    SPL_G3_WRITE(BEGIN_VTXS, GX_BEGIN_QUADS);
     TexCoord(0, 0);
     Vtx10((fx16)(x - FX32_ONE), 0, (fx16)(z + FX32_ONE));
     TexCoord(s, 0);
@@ -47,7 +67,7 @@ void drawXZPlane(fx32 s, fx32 t, fx32 x, fx32 z) {
     Vtx10((fx16)(x + FX32_ONE), 0, (fx16)(z - FX32_ONE));
     TexCoord(0, t);
     Vtx10((fx16)(x - FX32_ONE), 0, (fx16)(z - FX32_ONE));
-    reg_G3_END_VTXS = 0;
+    SPL_G3_WRITE(END_VTXS, 0);
 }
 
