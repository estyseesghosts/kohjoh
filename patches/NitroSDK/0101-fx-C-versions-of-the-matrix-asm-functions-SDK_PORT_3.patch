 // clang-format on
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_RotY43_(register MtxFx43 *pDst, register fx32 sinVal, register fx32 cosVal) {
+    pDst->_00 = cosVal; pDst->_01 = 0;        pDst->_02 = (fx32)(0u - (u32)sinVal);
+    pDst->_10 = 0;      pDst->_11 = FX32_ONE; pDst->_12 = 0;
+    pDst->_20 = sinVal; pDst->_21 = 0;        pDst->_22 = cosVal;
+    pDst->_30 = 0;      pDst->_31 = 0;        pDst->_32 = 0;
+}
+#else
 asm void MTX_RotY43_(register MtxFx43 *pDst, register fx32 sinVal, register fx32 cosVal) {
     str r1, [r0, #0x18]
     mov r3, #0
@@ -42,4 +62,5 @@ asm void MTX_RotY43_(register MtxFx43 *pDst, register fx32 sinVal, register fx32
     stmia r0!, {r1, r3}
     bx lr
 }
