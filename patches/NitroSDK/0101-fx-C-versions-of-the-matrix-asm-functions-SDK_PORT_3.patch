 src/fx/fx_mtx33_identity.c | 10 ++++++++++
 src/fx/fx_mtx33_rot_yz.c   | 19 +++++++++++++++++++
 src/fx/fx_mtx43_identity.c | 25 +++++++++++++++++++++++++
 src/fx/fx_mtx43_rot.c      | 21 +++++++++++++++++++++
 src/fx/fx_mtx43_scale.c    | 11 +++++++++++
