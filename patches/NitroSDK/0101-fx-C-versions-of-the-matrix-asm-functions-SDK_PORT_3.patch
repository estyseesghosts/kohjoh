     mov r2, #0x1000
     str r2, [r0, #0x20]
@@ -17,4 +26,5 @@ asm void MTX_Identity33_(register MtxFx33 *pDst) {
     stmia r0!, {r1, r3}
     bx lr
 }
+#endif
 // clang-format on
diff --git a/src/fx/fx_mtx33_rot_yz.c b/src/fx/fx_mtx33_rot_yz.c
index 759507e..a70f635 100644
--- a/src/fx/fx_mtx33_rot_yz.c
+++ b/src/fx/fx_mtx33_rot_yz.c
@@ -7,6 +7,15 @@ void MTX_RotZ33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32 cos
 #include <nitro/code16.h>
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+#include <nitro/fx/fx_const.h>
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_RotY33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32 cosVal) {
+    pDst->_00 = cosVal; pDst->_01 = 0;        pDst->_02 = (fx32)(0u - (u32)sinVal);
+    pDst->_10 = 0;      pDst->_11 = FX32_ONE; pDst->_12 = 0;
+    pDst->_20 = sinVal; pDst->_21 = 0;        pDst->_22 = cosVal;
+}
+#else
 asm void MTX_RotY33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32 cosVal) {
     str r2, [r0]
     str r2, [r0, #0x20]
@@ -23,9 +32,18 @@ asm void MTX_RotY33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32
     str r3, [r0, #0x10]
     bx lr
 }
+#endif
 // clang-format on
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_RotZ33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32 cosVal) {
+    pDst->_00 = cosVal;  pDst->_01 = sinVal;  pDst->_02 = 0;
+    pDst->_10 = (fx32)(0u - (u32)sinVal);   pDst->_11 = cosVal;  pDst->_12 = 0;
+    pDst->_20 = 0;       pDst->_21 = 0;       pDst->_22 = FX32_ONE;
+}
+#else
 asm void MTX_RotZ33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32 cosVal) {
     stmia r0!, {r2}
     mov r3, #0
@@ -40,4 +58,5 @@ asm void MTX_RotZ33_(register MtxFx33 *pDst, register fx32 sinVal, register fx32
     str r1, [r0, #0xc]
     bx lr
 }
+#endif
 // clang-format on
diff --git a/src/fx/fx_mtx43_identity.c b/src/fx/fx_mtx43_identity.c
index 9c43f06..b263254 100644
--- a/src/fx/fx_mtx43_identity.c
+++ b/src/fx/fx_mtx43_identity.c
@@ -7,6 +7,16 @@ void MTX_Copy43To44_(register const MtxFx43 *pSrc, register MtxFx44 *pDst);
 #include <nitro/code32.h>
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+#include <nitro/fx/fx_const.h>
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_Identity43_(register MtxFx43 *pDst) {
+    pDst->_00 = FX32_ONE; pDst->_01 = 0;        pDst->_02 = 0;
+    pDst->_10 = 0;        pDst->_11 = FX32_ONE; pDst->_12 = 0;
+    pDst->_20 = 0;        pDst->_21 = 0;        pDst->_22 = FX32_ONE;
+    pDst->_30 = 0;        pDst->_31 = 0;        pDst->_32 = 0;
+}
+#else
 asm void MTX_Identity43_(register MtxFx43 *pDst) {
     mov r2, #0x1000
     mov r3, #0
@@ -19,9 +29,23 @@ asm void MTX_Identity43_(register MtxFx43 *pDst) {
     stmia r0!, {r1, r3}
     bx lr
 }
+#endif
 // clang-format on
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_Copy43To44_(register const MtxFx43 *pSrc, register MtxFx44 *pDst) {
+    int r, c;
+
+    for (r = 0; r < 4; r++) {
+        for (c = 0; c < 3; c++) {
+            pDst->m[r][c] = pSrc->m[r][c];
+        }
+        pDst->m[r][3] = (r == 3) ? FX32_ONE : 0;
+    }
+}
+#else
 asm void MTX_Copy43To44_(register const MtxFx43 *pSrc, register MtxFx44 *pDst) {
     stmdb sp!, {r4}
     mov r12, #0
@@ -37,4 +61,5 @@ asm void MTX_Copy43To44_(register const MtxFx43 *pSrc, register MtxFx44 *pDst) {
     ldmia sp!, {r4}
     bx lr
 }
+#endif
 // clang-format on
