diff --git a/src/fx/fx_mtx22.c b/src/fx/fx_mtx22.c
index 2df2d9c..183c01f 100644
--- a/src/fx/fx_mtx22.c
+++ b/src/fx/fx_mtx22.c
@@ -8,6 +8,14 @@ void MTX_ScaleApply22(const MtxFx22 *mtx, MtxFx22 *dst, fx32 x, fx32 y);
 #include <nitro/code32.h>
 
 // clang-format off
+#ifdef SDK_PORT_3DS
+#include <nitro/fx/fx_const.h>
+/* GCC version (SDK_PORT_3DS). Same stores as the MWCC asm below, which the DS build keeps. */
+void MTX_Identity22_(MtxFx22 *mtx) {
+    mtx->_00 = FX32_ONE; mtx->_01 = 0;
+    mtx->_10 = 0;        mtx->_11 = FX32_ONE;
+}
+#else
 asm void MTX_Identity22_(MtxFx22 *mtx) {
     mov r1, #0x0
     mov r2, #0x1000
@@ -16,6 +24,7 @@ asm void MTX_Identity22_(MtxFx22 *mtx) {
     stmia r0!, {r1-r2}
     bx lr
 }
+#endif
 // clang-format on
 
 #pragma force_active on
