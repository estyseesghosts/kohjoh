; DS diffuse/specular lighting. NORMAL-time transformed normals are packed
; into the existing 16-byte vertex; lighting contexts are immutable per draw.
; Six clip matrices leave space for all four lights and the 128-byte LUT.
; Per-draw light flags (light_dir_hi.w: enabled, light_half_hi.w: specular
; colour non-zero; dp3 ignores w) skip disabled lights and the half-vector work of
; lights with no specular colour (their term is exactly zero): a vertex
; with one diffuse light runs 101 instructions instead of 409.
; Coffeepot 3d-scene-optimisation.md: reduce the per-vertex work.
.fvec palette[24]
.fvec texscale
.fvec light_dir_hi[4], light_dir_lo[4]
.fvec light_half_hi[4], light_half_lo[4]
.fvec ambient[4], diffuse[4], specular[4]
.fvec emission, params
.fvec shininess[32]
.constf base(0.000244140625, 1.0, 4.0, 0.0)
.constf colscale(0.00392156862745, 0.00392156862745, 0.00392156862745, 255.0)
.constf unpack(0.015625, 0.0625, 256.0, 1024.0)
.constf powers(8.0, 16.0, 512.0, 16384.0)
.constf limits(8192.0, 4096.0, 2048.0, 128.0)
.constf rates(0.25, 0.03125, 0.0078125, 0.125)
.constf thresholds(0.0, 1.0, 2.0, 3.0)
.out outpos position
.out outtc0 texcoord0
.out outclr color
.alias inpos v0
.alias inclr v1
.alias intc v2
.alias inmtx v3
.proc main
    mul r0.xyz, base.xxxx, inpos.xyzz
    mov r0.w, base.yyyy
    mov r15.x, base.wwww
    mul r15.y, powers.yyyy, r0.wwww
    mul r15.y, base.zzzz, r15.yyyy
    mov r15.z, limits.xxxx
    add r15.w, limits.wwww, -r0.wwww

    mul r5.z, rates.wwww, inmtx.xxxx
    flr r5.z, r5.zzzz
    mul r1.x, powers.xxxx, r5.zzzz
    add r1.x, inmtx.xxxx, -r1.xxxx
    mul r1.x, base.zzzz, r1.xxxx
    mova a0.x, r1.xxxx
    dp4 r2.x, palette[a0.x + 0], r0
    dp4 r2.y, palette[a0.x + 1], r0
    dp4 r2.z, palette[a0.x + 2], r0
    dp4 r2.w, palette[a0.x + 3], r0
    mov outpos, r2

    mul r4.xy, texscale.xyyy, intc.xyyy
    add r4.y, base.yyyy, r4.yyyy
    mov r4.zw, base.wwww
    mov outtc0, r4

    cmp limits.wwww, le, le, inmtx.yyyy
    jmpc !cmp.x, literal_color
    mul r5.x, unpack.xxxx, inclr.yyyy
    flr r5.x, r5.xxxx
    mul r5.y, unpack.yyyy, inclr.wwww
    flr r5.y, r5.yyyy
    mul r7.x, r15.yyyy, r5.xxxx
    add r7.x, inclr.yyyy, -r7.xxxx
    mul r7.x, unpack.zzzz, r7.xxxx
    add r6.x, inclr.xxxx, r7.xxxx
    mul r7.y, powers.yyyy, r5.yyyy
    add r7.y, inclr.wwww, -r7.yyyy
    mul r7.y, unpack.wwww, r7.yyyy
    mul r6.y, base.zzzz, inclr.zzzz
    add r6.y, r6.yyyy, r5.xxxx
    add r6.y, r6.yyyy, r7.yyyy
    mul r7.z, powers.yyyy, r5.zzzz
    add r6.z, r5.yyyy, r7.zzzz
    add r7.z, -limits.wwww, inmtx.yyyy
    mul r7.z, powers.zzzz, r7.zzzz
    add r6.z, r6.zzzz, r7.zzzz
    sge r7.xyz, r6, r15.zzzz
    mul r7.xyz, powers.wwww, r7
    add r6.xyz, r6, -r7
    mov r3.xyz, emission
    mov r3.w, params.xxxx
    mul r3.w, colscale.xxxx, r3.wwww

    ; Split signed normals in base 128. Every lighting intermediate now
    ; fits the PICA's 17 significant bits, including fixed-point floors.
    mul r12.xyz, rates.zzzz, r6
    flr r12.xyz, r12
    mul r13.xyz, limits.wwww, r12
    add r13.xyz, r6, -r13
    mov r0.x, rates.xxxx
    mul r15.z, limits.wwww, r0.xxxx

    cmp light_dir_hi[0].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, skip_light_0
    dp3 r1.x, light_dir_hi[0], r12
    dp3 r1.y, light_dir_lo[0], r12
    dp3 r1.z, light_dir_hi[0], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_dir_lo[0], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.x, r1.xxxx, r2.yyyy

    max r8.x, base.wwww, r8.xxxx
    min r8.x, limits.yyyy, r8.xxxx
    cmp light_half_hi[0].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, diffuse_0
    dp3 r1.x, light_half_hi[0], r12
    dp3 r1.y, light_half_lo[0], r12
    dp3 r1.z, light_half_hi[0], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_half_lo[0], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.y, r1.xxxx, r2.yyyy

    max r8.y, base.wwww, r8.yyyy
    min r8.y, limits.yyyy, r8.yyyy
    ; Exact floor(h*h/4096), without a lossy 24-bit product.
    mul r9.x, unpack.xxxx, r8.yyyy
    flr r9.x, r9.xxxx
    mul r9.y, r15.yyyy, r9.xxxx
    add r9.y, r8.yyyy, -r9.yyyy
    mul r10.x, r9.xxxx, r9.yyyy
    mul r10.y, rates.yyyy, r10.xxxx
    flr r10.y, r10.yyyy
    mul r10.z, r15.zzzz, r10.yyyy
    add r10.z, r10.xxxx, -r10.zzzz
    mul r10.z, limits.wwww, r10.zzzz
    mul r11.x, r9.yyyy, r9.yyyy
    add r10.z, r10.zzzz, r11.xxxx
    mul r10.z, base.xxxx, r10.zzzz
    flr r10.z, r10.zzzz
    mul r8.y, r9.xxxx, r9.xxxx
    add r8.y, r8.yyyy, r10.yyyy
    add r8.y, r8.yyyy, r10.zzzz
    cmp params.yyyy, gt, gt, r15.xxxx
    jmpc !cmp.x, no_shininess_0
    mul r9.x, rates.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    min r9.x, r15.wwww, r9.xxxx
    mul r9.y, rates.xxxx, r9.xxxx
    flr r9.y, r9.yyyy
    mova a0.y, r9.yyyy
    mul r9.y, base.zzzz, r9.yyyy
    add r9.x, r9.xxxx, -r9.yyyy
    sge r10, thresholds, r9.xxxx
    add r11, r10, -r10.wxyz
    mov r11.x, r10.xxxx
    dp4 r8.y, shininess[a0.y], r11
    ; floor(entry*4096/255) = entry*16 + floor(entry*16/255).
    mul r9.x, unpack.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    mul r10.x, colscale.wwww, r9.xxxx
    mul r8.y, powers.yyyy, r8.yyyy
    add r10.x, r8.yyyy, -r10.xxxx
    mov r11.w, colscale.wwww
    sge r10.x, r10.xxxx, r11.wwww
    add r8.y, r8.yyyy, r9.xxxx
    add r8.y, r8.yyyy, r10.xxxx
no_shininess_0:
    mul r10.xyz, specular[0], r8.yyyy
    add r10.xyz, limits.zzzz, r10
    mul r10.xyz, base.xxxx, r10
    flr r10.xyz, r10
    add r3.xyz, r3, r10
diffuse_0:
    mul r9.xyz, diffuse[0], r8.xxxx
    add r9.xyz, limits.zzzz, r9
    mul r9.xyz, base.xxxx, r9
    flr r9.xyz, r9
    add r9.xyz, ambient[0], r9
    add r3.xyz, r3, r9
skip_light_0:

    cmp light_dir_hi[1].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, skip_light_1
    dp3 r1.x, light_dir_hi[1], r12
    dp3 r1.y, light_dir_lo[1], r12
    dp3 r1.z, light_dir_hi[1], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_dir_lo[1], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.x, r1.xxxx, r2.yyyy

    max r8.x, base.wwww, r8.xxxx
    min r8.x, limits.yyyy, r8.xxxx
    cmp light_half_hi[1].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, diffuse_1
    dp3 r1.x, light_half_hi[1], r12
    dp3 r1.y, light_half_lo[1], r12
    dp3 r1.z, light_half_hi[1], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_half_lo[1], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.y, r1.xxxx, r2.yyyy

    max r8.y, base.wwww, r8.yyyy
    min r8.y, limits.yyyy, r8.yyyy
    ; Exact floor(h*h/4096), without a lossy 24-bit product.
    mul r9.x, unpack.xxxx, r8.yyyy
    flr r9.x, r9.xxxx
    mul r9.y, r15.yyyy, r9.xxxx
    add r9.y, r8.yyyy, -r9.yyyy
    mul r10.x, r9.xxxx, r9.yyyy
    mul r10.y, rates.yyyy, r10.xxxx
    flr r10.y, r10.yyyy
    mul r10.z, r15.zzzz, r10.yyyy
    add r10.z, r10.xxxx, -r10.zzzz
    mul r10.z, limits.wwww, r10.zzzz
    mul r11.x, r9.yyyy, r9.yyyy
    add r10.z, r10.zzzz, r11.xxxx
    mul r10.z, base.xxxx, r10.zzzz
    flr r10.z, r10.zzzz
    mul r8.y, r9.xxxx, r9.xxxx
    add r8.y, r8.yyyy, r10.yyyy
    add r8.y, r8.yyyy, r10.zzzz
    cmp params.yyyy, gt, gt, r15.xxxx
    jmpc !cmp.x, no_shininess_1
    mul r9.x, rates.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    min r9.x, r15.wwww, r9.xxxx
    mul r9.y, rates.xxxx, r9.xxxx
    flr r9.y, r9.yyyy
    mova a0.y, r9.yyyy
    mul r9.y, base.zzzz, r9.yyyy
    add r9.x, r9.xxxx, -r9.yyyy
    sge r10, thresholds, r9.xxxx
    add r11, r10, -r10.wxyz
    mov r11.x, r10.xxxx
    dp4 r8.y, shininess[a0.y], r11
    ; floor(entry*4096/255) = entry*16 + floor(entry*16/255).
    mul r9.x, unpack.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    mul r10.x, colscale.wwww, r9.xxxx
    mul r8.y, powers.yyyy, r8.yyyy
    add r10.x, r8.yyyy, -r10.xxxx
    mov r11.w, colscale.wwww
    sge r10.x, r10.xxxx, r11.wwww
    add r8.y, r8.yyyy, r9.xxxx
    add r8.y, r8.yyyy, r10.xxxx
no_shininess_1:
    mul r10.xyz, specular[1], r8.yyyy
    add r10.xyz, limits.zzzz, r10
    mul r10.xyz, base.xxxx, r10
    flr r10.xyz, r10
    add r3.xyz, r3, r10
diffuse_1:
    mul r9.xyz, diffuse[1], r8.xxxx
    add r9.xyz, limits.zzzz, r9
    mul r9.xyz, base.xxxx, r9
    flr r9.xyz, r9
    add r9.xyz, ambient[1], r9
    add r3.xyz, r3, r9
skip_light_1:

    cmp light_dir_hi[2].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, skip_light_2
    dp3 r1.x, light_dir_hi[2], r12
    dp3 r1.y, light_dir_lo[2], r12
    dp3 r1.z, light_dir_hi[2], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_dir_lo[2], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.x, r1.xxxx, r2.yyyy

    max r8.x, base.wwww, r8.xxxx
    min r8.x, limits.yyyy, r8.xxxx
    cmp light_half_hi[2].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, diffuse_2
    dp3 r1.x, light_half_hi[2], r12
    dp3 r1.y, light_half_lo[2], r12
    dp3 r1.z, light_half_hi[2], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_half_lo[2], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.y, r1.xxxx, r2.yyyy

    max r8.y, base.wwww, r8.yyyy
    min r8.y, limits.yyyy, r8.yyyy
    ; Exact floor(h*h/4096), without a lossy 24-bit product.
    mul r9.x, unpack.xxxx, r8.yyyy
    flr r9.x, r9.xxxx
    mul r9.y, r15.yyyy, r9.xxxx
    add r9.y, r8.yyyy, -r9.yyyy
    mul r10.x, r9.xxxx, r9.yyyy
    mul r10.y, rates.yyyy, r10.xxxx
    flr r10.y, r10.yyyy
    mul r10.z, r15.zzzz, r10.yyyy
    add r10.z, r10.xxxx, -r10.zzzz
    mul r10.z, limits.wwww, r10.zzzz
    mul r11.x, r9.yyyy, r9.yyyy
    add r10.z, r10.zzzz, r11.xxxx
    mul r10.z, base.xxxx, r10.zzzz
    flr r10.z, r10.zzzz
    mul r8.y, r9.xxxx, r9.xxxx
    add r8.y, r8.yyyy, r10.yyyy
    add r8.y, r8.yyyy, r10.zzzz
    cmp params.yyyy, gt, gt, r15.xxxx
    jmpc !cmp.x, no_shininess_2
    mul r9.x, rates.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    min r9.x, r15.wwww, r9.xxxx
    mul r9.y, rates.xxxx, r9.xxxx
    flr r9.y, r9.yyyy
    mova a0.y, r9.yyyy
    mul r9.y, base.zzzz, r9.yyyy
    add r9.x, r9.xxxx, -r9.yyyy
    sge r10, thresholds, r9.xxxx
    add r11, r10, -r10.wxyz
    mov r11.x, r10.xxxx
    dp4 r8.y, shininess[a0.y], r11
    ; floor(entry*4096/255) = entry*16 + floor(entry*16/255).
    mul r9.x, unpack.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    mul r10.x, colscale.wwww, r9.xxxx
    mul r8.y, powers.yyyy, r8.yyyy
    add r10.x, r8.yyyy, -r10.xxxx
    mov r11.w, colscale.wwww
    sge r10.x, r10.xxxx, r11.wwww
    add r8.y, r8.yyyy, r9.xxxx
    add r8.y, r8.yyyy, r10.xxxx
no_shininess_2:
    mul r10.xyz, specular[2], r8.yyyy
    add r10.xyz, limits.zzzz, r10
    mul r10.xyz, base.xxxx, r10
    flr r10.xyz, r10
    add r3.xyz, r3, r10
diffuse_2:
    mul r9.xyz, diffuse[2], r8.xxxx
    add r9.xyz, limits.zzzz, r9
    mul r9.xyz, base.xxxx, r9
    flr r9.xyz, r9
    add r9.xyz, ambient[2], r9
    add r3.xyz, r3, r9
skip_light_2:

    cmp light_dir_hi[3].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, skip_light_3
    dp3 r1.x, light_dir_hi[3], r12
    dp3 r1.y, light_dir_lo[3], r12
    dp3 r1.z, light_dir_hi[3], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_dir_lo[3], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.x, r1.xxxx, r2.yyyy

    max r8.x, base.wwww, r8.xxxx
    min r8.x, limits.yyyy, r8.xxxx
    cmp light_half_hi[3].wwww, gt, gt, r15.xxxx
    jmpc !cmp.x, diffuse_3
    dp3 r1.x, light_half_hi[3], r12
    dp3 r1.y, light_half_lo[3], r12
    dp3 r1.z, light_half_hi[3], r13
    add r1.y, r1.yyyy, r1.zzzz
    dp3 r1.z, light_half_lo[3], r13
    mul r2.x, rates.yyyy, r1.yyyy
    flr r2.x, r2.xxxx
    mul r2.y, r15.zzzz, r2.xxxx
    add r2.y, r1.yyyy, -r2.yyyy
    mul r2.y, limits.wwww, r2.yyyy
    add r2.y, r2.yyyy, r1.zzzz
    mul r2.y, base.xxxx, r2.yyyy
    flr r2.y, r2.yyyy
    mul r1.x, base.zzzz, r1.xxxx
    add r1.x, r1.xxxx, r2.xxxx
    add r8.y, r1.xxxx, r2.yyyy

    max r8.y, base.wwww, r8.yyyy
    min r8.y, limits.yyyy, r8.yyyy
    ; Exact floor(h*h/4096), without a lossy 24-bit product.
    mul r9.x, unpack.xxxx, r8.yyyy
    flr r9.x, r9.xxxx
    mul r9.y, r15.yyyy, r9.xxxx
    add r9.y, r8.yyyy, -r9.yyyy
    mul r10.x, r9.xxxx, r9.yyyy
    mul r10.y, rates.yyyy, r10.xxxx
    flr r10.y, r10.yyyy
    mul r10.z, r15.zzzz, r10.yyyy
    add r10.z, r10.xxxx, -r10.zzzz
    mul r10.z, limits.wwww, r10.zzzz
    mul r11.x, r9.yyyy, r9.yyyy
    add r10.z, r10.zzzz, r11.xxxx
    mul r10.z, base.xxxx, r10.zzzz
    flr r10.z, r10.zzzz
    mul r8.y, r9.xxxx, r9.xxxx
    add r8.y, r8.yyyy, r10.yyyy
    add r8.y, r8.yyyy, r10.zzzz
    cmp params.yyyy, gt, gt, r15.xxxx
    jmpc !cmp.x, no_shininess_3
    mul r9.x, rates.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    min r9.x, r15.wwww, r9.xxxx
    mul r9.y, rates.xxxx, r9.xxxx
    flr r9.y, r9.yyyy
    mova a0.y, r9.yyyy
    mul r9.y, base.zzzz, r9.yyyy
    add r9.x, r9.xxxx, -r9.yyyy
    sge r10, thresholds, r9.xxxx
    add r11, r10, -r10.wxyz
    mov r11.x, r10.xxxx
    dp4 r8.y, shininess[a0.y], r11
    ; floor(entry*4096/255) = entry*16 + floor(entry*16/255).
    mul r9.x, unpack.yyyy, r8.yyyy
    flr r9.x, r9.xxxx
    mul r10.x, colscale.wwww, r9.xxxx
    mul r8.y, powers.yyyy, r8.yyyy
    add r10.x, r8.yyyy, -r10.xxxx
    mov r11.w, colscale.wwww
    sge r10.x, r10.xxxx, r11.wwww
    add r8.y, r8.yyyy, r9.xxxx
    add r8.y, r8.yyyy, r10.xxxx
no_shininess_3:
    mul r10.xyz, specular[3], r8.yyyy
    add r10.xyz, limits.zzzz, r10
    mul r10.xyz, base.xxxx, r10
    flr r10.xyz, r10
    add r3.xyz, r3, r10
diffuse_3:
    mul r9.xyz, diffuse[3], r8.xxxx
    add r9.xyz, limits.zzzz, r9
    mul r9.xyz, base.xxxx, r9
    flr r9.xyz, r9
    add r9.xyz, ambient[3], r9
    add r3.xyz, r3, r9
skip_light_3:

    mul r15.y, rates.xxxx, r15.wwww
    flr r15.y, r15.yyyy
    min r3.xyz, r15.yyyy, r3
    mul r9.xyz, rates.xxxx, r3
    flr r9.xyz, r9
    mul r3.xyz, powers.xxxx, r3
    add r3.xyz, r3, r9
    mul r3.xyz, colscale, r3
    cmp base.wwww, eq, eq, r15.xxxx
    jmpc cmp.x, shaded
literal_color:
    mul r3.xyz, colscale, inclr
    mul r3.w, colscale.xxxx, inclr.wwww
shaded:
    mov outclr, r3
    end
.end
